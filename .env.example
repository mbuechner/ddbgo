# Database and Drupal.
MYSQL_DATABASE=ddbpro
MYSQL_HOSTNAME=localhost
MYSQL_PASSWORD=CHANGE_ME
MYSQL_PORT=3306
MYSQL_USER=ddbprouser
HASH_SALT=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
UPDATE_FREE_ACCESS=FALSE
FILE_PUBLIC_PATH=sites/default/files
FILE_PRIVATE_PATH=/var/www/html/private
TMP=/tmp
TRUSTED_HOST_PATTERNS="^localhost\$, ^127.0.0.1\$"

# Optional maintenance tasks during container startup.
UPDATEDB_ON_STARTUP=no
CONFIG_IMPORT_ON_STARTUP=no
CACHEREBUILD_ON_STARTUP=no

# HTTP Basic Auth is enabled only when both user and password are non-empty.
HTPASSWD_USER=
HTPASSWD_PWD=
HTPASSWD_GREETING="DDBpro test system"

# External Redis. Replace CHANGE_ME before enabling Redis.
USE_REDIS=no
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

# External SMTP. Replace example.org and CHANGE_ME before enabling SMTP.
SMTP_ENABLED=no
SMTP_HOST=smtp.example.org
SMTP_HOST_BACKUP=smtp-backup.example.org
SMTP_PORT=587
SMTP_PROTOCOL=tls
SMTP_AUTOTLS=yes
SMTP_TIMEOUT=30
SMTP_USERNAME=noreply@example.org
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=noreply@example.org
SMTP_FROM_NAME=DDBpro
SMTP_CLIENT_HOSTNAME=ddbpro.example.org
SMTP_CLIENT_HELO=ddbpro.example.org
SMTP_ALLOW_HTML=yes
SMTP_TEST_ADDRESS=developer@example.org
# Keep empty unless all outgoing mail should be redirected.
SMTP_REROUTE_ADDRESS=
SMTP_DEBUGGING=no
SMTP_DEBUG_LEVEL=1
SMTP_KEEPALIVE=no
