<?php

declare(strict_types=1);

use Drupal\ddbgo_cj\KweQueueWorker;
use Drupal\node\NodeInterface;

/**
 * Adds every published KWE to the update queue once a day.
 */
function ddbgo_cj_kwe_daily_queue_worker(): void {
  _ddbgo_cj_worker()->enqueuePublishedNodes();
}

/**
 * Processes currently available KWE queue items within the worker's time limit.
 */
function ddbgo_cj_kwe_queue_worker(): void {
  _ddbgo_cj_worker()->processQueue();
}

/**
 * Implements hook_node_insert().
 */
function ddbgo_cj_node_insert(NodeInterface $node): void {
  if ($node->bundle() === 'kwe') {
    _ddbgo_cj_worker()->enqueueNode($node);
  }
}

/**
 * Implements hook_node_update().
 */
function ddbgo_cj_node_update(NodeInterface $node): void {
  ddbgo_cj_node_insert($node);
}

/**
 * Returns the KWE queue worker service.
 */
function _ddbgo_cj_worker(): KweQueueWorker {
  return \Drupal::service('ddbgo_cj.kwe_queue_worker');
}

/**
 * Disables Update Manager checks for this custom module.
 */
function ddbgo_cj_update_projects_alter(array &$projects): void {
  unset($projects['ddbgo_cj']);
}

/**
 * Disables locale translation update checks for this custom module.
 */
function ddbgo_cj_locale_translation_projects_alter(array &$projects): void {
  unset($projects['ddbgo_cj']);
}
