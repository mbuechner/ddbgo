{#
/**
 * @file
 * Theme-integrated navigation for the configured Toolbar Menu entries.
 */
#}
{% if items or account_links %}
  <nav class="ddbgo-workspace-navigation{{ is_authenticated ? '' : ' ddbgo-workspace-navigation--anonymous' }}" aria-label="{{ 'DDBgo workspace navigation'|t }}">
    {% if is_authenticated %}
      <button class="ddbgo-workspace-navigation__menu-toggle" type="button" aria-label="{{ 'Menu'|t }}" aria-expanded="false" aria-controls="ddbgo-workspace-navigation-menu">
        <span>{{ 'Menu'|t }}</span>
      </button>
      <ul id="ddbgo-workspace-navigation-menu" class="ddbgo-workspace-navigation__list">
        {% for item in items %}
          {% set panel_id = 'ddbgo-workspace-navigation-' ~ item.id|clean_id %}
          <li class="ddbgo-workspace-navigation__item ddbgo-workspace-navigation__item--{{ item.id|clean_class }}">
            <button class="ddbgo-workspace-navigation__toggle toolbar-icon-toolbar-menu-{{ item.id|clean_class }}" type="button" aria-label="{{ item.label }}" title="{{ item.label }}" aria-expanded="false" aria-controls="{{ panel_id }}">
              <span>{{ item.label }}</span>
            </button>
            <div id="{{ panel_id }}" class="ddbgo-workspace-navigation__dropdown" hidden>
              {{ item.menu }}
            </div>
          </li>
        {% endfor %}
        <li class="ddbgo-workspace-navigation__item ddbgo-workspace-navigation__item--account">
          <button class="ddbgo-workspace-navigation__toggle ddbgo-workspace-navigation__toggle--account" type="button" aria-label="{{ account_label }}" title="{{ account_label }}" aria-expanded="false" aria-controls="ddbgo-workspace-navigation-account">
            <span>{{ account_label }}</span>
          </button>
          <div id="ddbgo-workspace-navigation-account" class="ddbgo-workspace-navigation__dropdown" hidden>
            <ul class="toolbar-menu">
              {% for link in account_links %}
                <li>{{ link }}</li>
              {% endfor %}
            </ul>
          </div>
        </li>
      </ul>
    {% else %}
      {{ account_links.login }}
    {% endif %}
  </nav>
{% endif %}
