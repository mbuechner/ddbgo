{# Names and the tooltip relationship are rendered before JavaScript runs.
   The description follows the button in its wrapper template (outside summary
   for details). It stays readable inline when JavaScript is unavailable. #}
{{ attach_library('ddbgo_gin/form_help') }}
<button class="ddbgo-help-toggle" type="button"
  aria-label="{{ mouseover ? 'Hilfe zu @label'|t({'@label': label|striptags|trim}) : 'Weitere Informationen'|t }}"
  aria-describedby="{{ description_id }}">
  <span aria-hidden="true">?</span>
</button>
