<?php

/**
 * @file
 * DDBgo integration and behavior for Gin-based themes.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Render\Element;
use Drupal\Core\StringTranslation\TranslatableMarkup;
use Drupal\Core\Template\Attribute;
use Drupal\node\Form\NodeForm;
use Drupal\node\NodeInterface;
use Symfony\Component\String\AbstractUnicodeString;
use Symfony\Component\String\UnicodeString;

/**
 * Implements hook_page_attachments().
 */
function ddbgo_gin_page_attachments(array &$attachments): void {
  $active_theme = \Drupal::service('theme.manager')->getActiveTheme();
  $is_gin_based_theme = $active_theme->getName() === 'gin' || isset($active_theme->getBaseThemeExtensions()['gin']);
  $is_gin_frontend = $active_theme->getName() === 'gin_frontend'
    || isset($active_theme->getBaseThemeExtensions()['gin_frontend']);

  if ($is_gin_frontend) {
    $attachments['#attached']['library'][] = 'ddbgo_gin/frontend_layout';
  }

  if (
    !$is_gin_based_theme ||
    !\Drupal::currentUser()->hasPermission('access toolbar')
  ) {
    return;
  }

  $attachments['#attached']['library'][] = 'ddbgo_gin/toolbar_icons';
}

/**
 * Implements hook_toolbar_alter().
 *
 * The configured workspace menus are rendered in Gin Frontend's header. Keep
 * the Drupal administration toolbar focused on administration links only.
 */
function ddbgo_gin_toolbar_alter(array &$items): void {
  foreach (array_keys($items) as $key) {
    if (str_starts_with($key, 'toolbar_menu_')) {
      unset($items[$key]);
    }
  }
}

/**
 * Implements hook_theme().
 */
function ddbgo_gin_theme(): array {
  return [
    'block__ddbgo_linked_content_view' => [
      'base hook' => 'block',
      'template' => 'block--ddbgo-linked-content-view',
    ],
    'ddbgo_workspace_navigation' => [
      'variables' => [
        'items' => [],
        'is_authenticated' => FALSE,
        'account_label' => NULL,
        'account_links' => [],
      ],
      'template' => 'ddbgo-workspace-navigation',
    ],
  ];
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for block templates.
 */
function ddbgo_gin_theme_suggestions_block_alter(array &$suggestions, array $variables): void {
  $plugin_id = $variables['elements']['#plugin_id'] ?? NULL;
  $linked_content_views = [
    'views_block:aggregator-block_1',
    'views_block:kwe-block',
    'views_block:person-person_aggregator',
    'views_block:person-person_bestand',
    'views_block:person-person_kwe',
  ];

  if (is_string($plugin_id) && in_array($plugin_id, $linked_content_views, TRUE)) {
    $suggestions[] = 'block__ddbgo_linked_content_view';
  }
}

/**
 * Implements hook_theme_registry_alter().
 *
 * Gin provides route-specific page templates (for example page--node) that
 * otherwise take precedence over Gin Frontend's page template and omit its
 * branding and navigation regions.
 */
function ddbgo_gin_theme_registry_alter(array &$theme_registry): void {
  if (isset($theme_registry['page'])) {
    $theme_registry['page__gin_frontend'] = $theme_registry['page'];

    // Gin ships a dedicated page--node-add template which bypasses Gin
    // Frontend's chrome. Point that exact suggestion at the active frontend
    // page implementation as well.
    $active_theme = \Drupal::service('theme.manager')->getActiveTheme();
    $is_gin_frontend = $active_theme->getName() === 'gin_frontend'
      || isset($active_theme->getBaseThemeExtensions()['gin_frontend']);

    if ($is_gin_frontend && isset($theme_registry['page__node_add'])) {
      $theme_registry['page__node_add'] = $theme_registry['page'];
    }
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for page templates.
 */
function ddbgo_gin_theme_suggestions_page_alter(array &$suggestions): void {
  $active_theme = \Drupal::service('theme.manager')->getActiveTheme();
  $is_gin_frontend = $active_theme->getName() === 'gin_frontend'
    || isset($active_theme->getBaseThemeExtensions()['gin_frontend']);

  if ($is_gin_frontend) {
    $suggestions[] = 'page__gin_frontend';
  }
}

/**
 * Implements hook_form_views_exposed_form_alter().
 *
 * Prevents browsers from suggesting unrelated previous searches in the
 * exposed full-text query fields used throughout DDBgo.
 */
function ddbgo_gin_form_views_exposed_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  if (isset($form['query'])) {
    $form['query']['#attributes']['autocomplete'] = 'off';
  }

  $active_theme = \Drupal::service('theme.manager')->getActiveTheme();
  $is_gin_frontend = $active_theme->getName() === 'gin_frontend'
    || isset($active_theme->getBaseThemeExtensions()['gin_frontend']);

  if (!$is_gin_frontend) {
    return;
  }

  $form['#after_build'][] = 'ddbgo_gin_build_exposed_filter_details';
}

/**
 * Groups finalized exposed filter widgets in Gin's native details element.
 */
function ddbgo_gin_build_exposed_filter_details(array $form, FormStateInterface $form_state): array {
  if (isset($form['ddbgo_exposed_filters'])) {
    return $form;
  }

  // Views normally applies exposed labels during theme preprocessing. Since
  // the elements are nested below, apply the same metadata before moving them.
  foreach ($form['#info'] ?? [] as $info) {
    $value_key = $info['value'] ?? NULL;
    if (is_string($value_key) && isset($form[$value_key])) {
      if (!empty($info['label'])) {
        $form[$value_key]['#title'] = $info['label'];
      }
      if (!empty($info['description'])) {
        $form[$value_key]['#description'] = $info['description'];
      }
    }
  }

  $filter_keys = [];
  $tag_filter_keys = [];

  foreach (Element::children($form) as $key) {
    $type = $form[$key]['#type'] ?? NULL;
    $classes = $form[$key]['#attributes']['class'] ?? [];
    $classes = is_array($classes) ? $classes : [$classes];

    if (
      (is_string($type) && str_contains($type, 'tagify'))
      || in_array('tagify-select-widget', $classes, TRUE)
    ) {
      $tag_filter_keys[] = $key;
    }
    elseif (is_string($type) && $type !== 'hidden') {
      $filter_keys[] = $key;
    }
  }

  if ($filter_keys === []) {
    return $form;
  }

  $user_input = $form_state->getUserInput();
  $has_active_filter = FALSE;
  foreach ($filter_keys as $key) {
    if (
      ($form[$key]['#type'] ?? NULL) !== 'actions'
      && array_key_exists($key, $user_input)
      && ddbgo_gin_exposed_filter_has_selection($form[$key], $user_input[$key])
    ) {
      $has_active_filter = TRUE;
      break;
    }
  }

  if ($tag_filter_keys !== [] && isset($form['actions']['submit'])) {
    // Use Better Exposed Filters' field-level autosubmit. Tagify dispatches a
    // native change event on its underlying select after add/remove, which BEF
    // forwards to the existing Views submit button (including AJAX behavior).
    $form['actions']['submit']['#attributes']['data-bef-auto-submit-click'] = '';
    $form['#attached']['library'][] = 'better_exposed_filters/auto_submit';
  }

  $details = [
    '#type' => 'details',
    '#title' => new TranslatableMarkup('Filter'),
    '#open' => $has_active_filter,
    '#weight' => -100,
    '#attributes' => [
      'class' => ['ddbgo-exposed-filters'],
    ],
  ];

  foreach ($filter_keys as $key) {
    if (($form[$key]['#type'] ?? NULL) === 'actions') {
      $form[$key]['#attributes']['class'][] = 'views-exposed-form__item';
      $form[$key]['#attributes']['class'][] = 'views-exposed-form__item--actions';
    }
    else {
      $form[$key]['#wrapper_attributes']['class'][] = 'views-exposed-form__item';
    }

    $details[$key] = $form[$key];
    unset($form[$key]);
  }

  $form['ddbgo_exposed_filters'] = $details;

  // Tag filters stay outside the collapsible details and therefore remain
  // available as the full-width final row directly above the view results.
  foreach ($tag_filter_keys as $key) {
    $form[$key]['#weight'] = -90;
    $form[$key]['#attributes']['data-bef-auto-submit'] = '';
    $form[$key]['#wrapper_attributes']['class'][] = 'ddbgo-exposed-filter--tags';
  }

  return $form;
}

/**
 * Determines whether an exposed filter differs from its empty default value.
 */
function ddbgo_gin_exposed_filter_has_selection(array $element, mixed $input): bool {
  $values = is_array($input) ? $input : [$input];
  $default_value = $element['#default_value'] ?? array_key_first($element['#options'] ?? []);
  $multiple = $element['#multiple'] ?? FALSE;

  foreach ($values as $value) {
    if (is_array($value)) {
      if (ddbgo_gin_exposed_filter_has_selection($element, $value)) {
        return TRUE;
      }
      continue;
    }

    if ($multiple) {
      if ($value !== '' && $value !== NULL) {
        return TRUE;
      }
    }
    elseif ($value !== $default_value && ($value || $default_value === 0)) {
      return TRUE;
    }
  }

  return FALSE;
}

/**
 * Implements hook_form_alter().
 *
 * Normalizes editorial values for the supported DDBgo content types.
 */
function ddbgo_gin_normalize_bundle_identifier(string $identifier): ?string {
  $normalized = strtolower(trim($identifier));
  $normalized = preg_replace('/[^a-z0-9_]+/', '_', $normalized);
  $normalized = preg_replace('/_+/', '_', $normalized);
  $normalized = trim($normalized, '_');

  if ($normalized === '') {
    return NULL;
  }

  foreach (['kwe', 'bestand', 'person', 'aggregator'] as $bundle_name) {
    if (str_contains($normalized, $bundle_name)) {
      return $bundle_name;
    }
  }

  return NULL;
}

function ddbgo_gin_resolve_bundle_from_route(): ?string {
  $route_match = \Drupal::routeMatch();

  $node = $route_match->getParameter('node');
  if ($node instanceof NodeInterface) {
    return $node->bundle();
  }

  $node_type = $route_match->getParameter('node_type');
  if ($node_type instanceof \Drupal\node\NodeTypeInterface) {
    return $node_type->id();
  }

  $path = \Drupal::request()->getPathInfo();
  if (is_string($path) && $path !== '') {
    $normalized_path = rtrim(strtolower($path), '/');
    $path_map = [
      '/search/kwe' => 'kwe',
      '/search/bestand' => 'bestand',
      '/search/person' => 'person',
      '/search/aggregator' => 'aggregator',
      '/search/personen' => 'person',
      '/admin/kwe' => 'kwe',
      '/admin/bestand' => 'bestand',
      '/admin/person' => 'person',
      '/admin/aggregator' => 'aggregator',
    ];

    if (isset($path_map[$normalized_path])) {
      return $path_map[$normalized_path];
    }
  }

  $view_id = $route_match->getParameter('view_id');
  if (is_string($view_id) && $view_id !== '') {
    $bundle = ddbgo_gin_normalize_bundle_identifier($view_id);
    if ($bundle !== NULL) {
      return $bundle;
    }
  }

  $route_name = $route_match->getRouteName();
  if (is_string($route_name)) {
    foreach (explode('.', $route_name) as $route_part) {
      $bundle = ddbgo_gin_normalize_bundle_identifier($route_part);
      if ($bundle !== NULL) {
        return $bundle;
      }
    }
  }

  return NULL;
}

function ddbgo_gin_attribute_from_value(mixed $attributes): Attribute {
  if ($attributes instanceof Attribute) {
    return $attributes;
  }

  if (is_array($attributes)) {
    return new Attribute($attributes);
  }

  return new Attribute();
}

function ddbgo_gin_preprocess_html(array &$variables): void {
  $bundle = ddbgo_gin_resolve_bundle_from_route();

  if ($bundle !== NULL && in_array($bundle, ['kwe', 'bestand', 'person', 'aggregator'], TRUE)) {
    $attributes = ddbgo_gin_attribute_from_value($variables['html_attributes'] ?? []);
    $attributes->setAttribute('data-ddbgo-node-bundle', $bundle);
    $variables['html_attributes'] = $attributes;
  }
}

function ddbgo_gin_preprocess_page_title(array &$variables): void {
  $bundle = ddbgo_gin_resolve_bundle_from_route();

  if ($bundle !== NULL && in_array($bundle, ['kwe', 'bestand', 'person', 'aggregator'], TRUE)) {
    $attributes = ddbgo_gin_attribute_from_value($variables['title_attributes'] ?? []);
    $attributes->addClass([
      'page-title--ddbgo-type',
      'page-title--ddbgo-type-' . $bundle,
    ]);
    $variables['title_attributes'] = $attributes;
  }
}

/**
 * Implements hook_preprocess_HOOK() for flag links.
 *
 * A bookmark removed from the bookmark View no longer belongs in its result
 * set. Use Flag's non-JavaScript fallback on that page so the refreshed View
 * immediately omits the affected row.
 */
function ddbgo_gin_preprocess_flag(array &$variables): void {
  if (
    \Drupal::routeMatch()->getRouteName() !== 'view.flag_bookmark.page'
    || ($variables['action'] ?? NULL) !== 'unflag'
    || ($variables['flag'] ?? NULL)?->id() !== 'bookmark'
  ) {
    return;
  }

  $attributes = ddbgo_gin_attribute_from_value($variables['attributes'] ?? []);
  $attributes->removeClass('use-ajax');
  $variables['attributes'] = $attributes;
}

function ddbgo_gin_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  if ($form_id === 'views_form_flag_bookmark_page') {
    ddbgo_gin_alter_bookmark_bulk_form($form);
  }

  $form_object = $form_state->getFormObject();
  if (!$form_object instanceof NodeForm) {
    return;
  }

  $normalized_bundles = ['kwe', 'bestand', 'person', 'aggregator'];
  if (!in_array($form_object->getEntity()->bundle(), $normalized_bundles, TRUE)) {
    return;
  }

  $validators = $form['#validate'] ?? [];

  // Form API expects a list, but custom forms occasionally provide one
  // callback directly. Preserve that callback while normalizing the shape.
  if (is_callable($validators)) {
    $validators = [$validators];
  }
  elseif (!is_array($validators)) {
    $validators = [];
  }

  if (!in_array('ddbgo_gin_normalize_form_values', $validators, TRUE)) {
    array_unshift($validators, 'ddbgo_gin_normalize_form_values');
  }

  $form['#validate'] = $validators;
}

/**
 * Replaces the redundant one-option bulk-action select with a direct button.
 */
function ddbgo_gin_alter_bookmark_bulk_form(array &$form): void {
  $bulk_form_id = 'flagging_bulk_form';

  if (!isset($form['header'][$bulk_form_id]['action'])) {
    return;
  }

  $form['header'][$bulk_form_id]['action'] = [
    '#type' => 'hidden',
    '#value' => 'flag_delete_flagging',
  ];

  $button_label = new TranslatableMarkup('Ausgewählte Lesezeichen entfernen');
  if (isset($form['header'][$bulk_form_id]['actions']['submit'])) {
    $form['header'][$bulk_form_id]['actions']['submit']['#value'] = $button_label;
  }
  if (isset($form['actions']['submit'])) {
    $form['actions']['submit']['#value'] = $button_label;
  }
}

/**
 * Normalizes all submitted form values before the form's own validators run.
 */
function ddbgo_gin_normalize_form_values(array &$form, FormStateInterface $form_state): void {
  foreach ($form_state->getValues() as $key => $value) {
    ddbgo_gin_normalize_form_value($value);
    $form_state->setValue($key, $value);
  }
}

/**
 * Recursively trims and NFC-normalizes string values.
 */
function ddbgo_gin_normalize_form_value(mixed &$value): void {
  if (is_array($value)) {
    foreach ($value as &$nested_value) {
      ddbgo_gin_normalize_form_value($nested_value);
    }
  }
  elseif (is_string($value)) {
    $value = (new UnicodeString($value))
      ->normalize(AbstractUnicodeString::NFC)
      ->trim()
      ->toString();
  }
}

/**
 * Disable locale translation update checks for this custom module.
 *
 * @param array $projects
 *   Project data used by locale translation update checks.
 */
function ddbgo_gin_locale_translation_projects_alter(array &$projects): void {
  unset($projects['ddbgo_gin']);
}
