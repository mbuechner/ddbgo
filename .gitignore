# Ignore directories generated by Composer
/drush/contrib/
/vendor/
/sites/
/themes/
/modules/
/profiles/
/web/core/
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/
/web/libraries/

# Ignore sensitive information
/web/sites/*/settings.php
/web/sites/*/settings.local.php

# Ignore Drupal's file directory
/web/sites/*/files/

# Ignore SimpleTest multi-site environment.
/web/sites/simpletest

# Ignore files generated by PhpStorm
/.idea/

# Ignore .env files as they are personal
/.env
/.env.local
/.env.*.local

# Ignore files generated by editors
/.vscode/
/nbproject/private/

# Ignore package-manager debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

/*.zip
/*.sql
/.buildpath
/.project
/.csslintrc
/.eslintignore
/.eslintrc.json
/.ht.router.php
/.htaccess
/INSTALL.txt
/README.txt
/autoload.php
/example.gitignore
/index.php
/robots.txt
/update.php
/web.config
/.editorconfig
/autoload_runtime.php

# NodeJS
/node_modules/
