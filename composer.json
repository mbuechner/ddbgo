{
    "name": "ddbkultur/ddbgo",
    "description": "DDBgo is a database of the German Digital Library that provides information on cultural and academic institutions, collections, aggregators, and contact persons. DDBgo is an internal administrative and operational tool used by the Service Center and the specialized units of the German Digital Library.",
    "type": "project",
    "license": "Apache-2.0",
    "homepage": "https://github.com/mbuechner/ddbgo",
    "support": {
        "docs": "https://www.drupal.org/docs/user_guide/en/index.html",
        "chat": "https://www.drupal.org/node/314178"
    },
    "authors": [
        {
            "name": "Michael Büchner <m.buechner@dnb.de>",
            "role": "Developer"
        }
    ],
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "require": {
        "php": ">=8.5",
        "ext-gd": "*",
        "ext-imagick": "*",
        "cweagans/composer-patches": "^2.0",
        "drupal/admin_toolbar": "^3.6",
        "drupal/auto_entitylabel": "^3.4",
        "drupal/better_exposed_filters": "^7",
        "drupal/color": "^2.0@alpha",
        "drupal/color-color": "^1.0",
        "drupal/color_field": "^3.0",
        "drupal/conditional_fields": "^4.0@alpha",
        "drupal/content_lock": "^3.0@alpha",
        "drupal/core-composer-scaffold": "^11",
        "drupal/core-project-message": "^11",
        "drupal/core-recipe-unpack": "^11",
        "drupal/core-recommended": "^11",
        "drupal/csv_serialization": "^4.0",
        "drupal/custom_formatters": "^4.1",
        "drupal/date_popup": "^2.0",
        "drupal/diff": "^2.1",
        "drupal/empty_fields": "^1.0",
        "drupal/entity_reference_integrity": "^2.0",
        "drupal/entity_reference_revisions": "^1.14",
        "drupal/exclude_node_title": "^2.0",
        "drupal/facets": "^3.0",
        "drupal/field_defaults": "^2.1",
        "drupal/field_group": "^4.0",
        "drupal/field_validation": "^3.0@beta",
        "drupal/flag": "^5.0",
        "drupal/flood_control": "^3.0",
        "drupal/form_options_attributes": "^2.1",
        "drupal/gin": "^5.0",
        "drupal/gin_everywhere": "^1.5",
        "drupal/gin_frontend": "^1.0@alpha",
        "drupal/gin_login": "^2.1",
        "drupal/gin_toolbar": "^3.0",
        "drupal/gin_toolbar_custom_menu": "^1.0",
        "drupal/happy_new_year": "^2.0",
        "drupal/health_check": "^3.2",
        "drupal/hook_post_action": "^2.0",
        "drupal/jquery_ui_accordion": "^2.1",
        "drupal/jquery_ui_datepicker": "^2.1",
        "drupal/jquery_ui_slider": "^2.1",
        "drupal/jquery_ui_touch_punch": "^1.1",
        "drupal/jsonapi_extras": "^3.28",
        "drupal/key_auth": "^2.2",
        "drupal/libraries": "^4.1",
        "drupal/menu_block": "^1.14",
        "drupal/metatag": "^2.2",
        "drupal/node_view_permissions": "^2.0",
        "drupal/noreqnewpass": "^1.6",
        "drupal/paragraphs": "^1.23",
        "drupal/redis": "^1.11",
        "drupal/role_delegation": "^1.6",
        "drupal/search_api": "^1.41",
        "drupal/select2": "^2.0",
        "drupal/semanticviews": "^3.1",
        "drupal/smtp": "^1.4",
        "drupal/tagify": "^2.0",
        "drupal/taxonomy_unique": "^2.6",
        "drupal/term_merge": "^2.0",
        "drupal/toastify": "^1.3",
        "drupal/token": "^1.17",
        "drupal/toolbar_menu": "^3.1",
        "drupal/toolbar_menu_clean": "^2.0",
        "drupal/ultimate_cron": "^2.0@beta",
        "drupal/unique_field_ajax": "^2.2",
        "drupal/upgrade_status": "^4.3",
        "drupal/user_switcher": "^1.0",
        "drupal/userprotect": "^1.4",
        "drupal/views_data_export": "^1.10",
        "drupal/viewsreference": "^2.0@beta",
        "drush/drush": "^13.7",
        "mnsami/composer-custom-directory-installer": "^2.2",
        "npm-asset/fortawesome--fontawesome-free": "^7",
        "npm-asset/select2": "^4.1",
        "vlucas/phpdotenv": "^5.7",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "beta",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "drupal/core-recipe-unpack": true,
            "mnsami/composer-custom-directory-installer": true,
            "symfony/runtime": true,
            "wikimedia/composer-merge-plugin": true
        },
        "platform": {
            "php": "8.5",
            "ext-gd": "1",
            "ext-imagick": "3"
        }
    },
    "autoload": {
        "files": [
            "load.environment.php"
        ]
    },
    "extra": {
    	"drupal-scaffold": {
            "initial": {
                ".editorconfig": "../.editorconfig",
                ".gitattributes": "../.gitattributes"
            },
            "locations": {
                "web-root": "web/"
        },
            "file-mapping": {
            	"[web-root]/robots.txt": false,
                "[web-root]/README.md": false
            }
        },
        "patchLevel": {
            "drupal/core": "-p2"
        },
        "merge-plugin": {
            "include": [
                "web/modules/contrib/*/composer.libraries.json",
                "web/modules/custom/*/composer.libraries.json"
            ],
            "recurse": true,
            "replace": false,
            "ignore-duplicates": false,
            "merge-dev": true,
            "merge-extra": false,
            "merge-extra-deep": false,
            "merge-scripts": false
        },
        "installer-types": [
            "npm-asset",
            "drupal-core",
            "drupal-drush",
            "drupal-library",
            "drupal-module",
            "drupal-profile",
            "drupal-theme"
        ],
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/fontawesome": [
                "npm-asset/fortawesome--fontawesome-free"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library",
                "type:npm-asset"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "web/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "web/profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "web/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ]
        },
        "enable-patching": true,
        "composer-exit-on-patch-failure": true,
        "patches": {
            "drupal/select2": {
                "Changed tokenSeparator in Select2 module": "patches/Changed_tokenSeparator_in_Select2_module.patch"
            },
            "drupal/toolbar_menu": {
                "Fix Gin class conflict and empty menu links (3271757)": "patches/toolbar_menu-gin-compatibility.patch"
            },
            "drupal/unique_field_ajax": {
                "Fixing bug with warning message at Unique Field Ajax": "patches/Bugfix_for_Warning_Message_in_unique_field_ajax_module.patch"
            }
        }
    }
}
